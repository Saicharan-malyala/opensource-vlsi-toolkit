# ==============================================================================
# versions.env - Open-Source EDA Tools Version Pinning Configuration
# ==============================================================================
# Rule: Never hardcode "latest". All versions, commit pins, and image tags
# live in this file. The install scripts resolve latest stable versions
# dynamically via GitHub/PyPI/Docker Hub APIs if unset, or use these pins.
# Verified against upstream repositories on-date (October 2026).
# ==============================================================================

# Core Orchestration and PDK (FOSSi Foundation)
LIBRELANE_VERSION="3.0.0"
CIEL_VERSION="3.0.0"
SKY130_PDK_FAMILY="sky130"

# Part B All-In-One Container (JKU Linz)
IIC_OSIC_TOOLS_IMAGE="hpretl/iic-osic-tools:latest"
IIC_OSIC_TOOLS_REPO="https://github.com/iic-jku/IIC-OSIC-TOOLS.git"

# Digital Flow & Simulation Tools
YOSYS_VERSION="0.69"
IVERILOG_VERSION="v13_0"
VERILATOR_VERSION="v5.052"
GTKWAVE_VERSION="v3.3.128"
OPENROAD_VERSION="v2.0-16503"
OPENSTA_VERSION="2.6.2"

# Physical Verification & Layout
MAGIC_VERSION="8.3.498"
NETGEN_VERSION="1.5.275"
KLAYOUT_VERSION="0.30.12"
XSCHEM_VERSION="3.4.7"
NGSPICE_VERSION="44.2"

# Verification & Python Ecosystem
COCOTB_VERSION="1.9.2"
PYUVM_VERSION="0.3.4"

# Host Utilities & System Tools
GH_CLI_VERSION="2.67.0"
MAKE_MIN_VERSION="4.3"
GIT_MIN_VERSION="2.35.0"
PYTHON_MIN_VERSION="3.10.0"
DOCKER_MIN_VERSION="25.0.5"
DOCKER_DESKTOP_MIN_VERSION="4.37.1"
